# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/comitiva
ENABLE_TEST_ADMIN=false

# JWT e proteção de OTP — gerar valores fortes fora do repositório
JWT_SECRET=GERE_UMA_CHAVE_COM_OPENSSL_RAND_HEX_32
OTP_PEPPER=GERE_OUTRA_CHAVE_FORTE_COM_OPENSSL_RAND_HEX_32
SYSTEM_SECRETS_MASTER_KEY=GERE_OUTRA_CHAVE_FORTE_COM_OPENSSL_RAND_HEX_32
AVISO_PRIVACIDADE_VERSION=2026.1

# Servidor
TRUSTED_PROXY_IPS=127.0.0.1,::1
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
MOBILE_URL=comitiva://

# SMTP / Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Excursão das Comitivas <sistema@excursaodascomitivas.com.br>
EMAIL_FROM_SYSTEM=Excursão das Comitivas <sistema@excursaodascomitivas.com.br>
EMAIL_FROM_SUPPORT=Excursão das Comitivas | Atendimento <atendimento@excursaodascomitivas.com.br>
EMAIL_FROM_CONTRACTS=Excursão das Comitivas | Contratos <contratos@excursaodascomitivas.com.br>
EMAIL_FROM_FINANCE=Excursão das Comitivas | Financeiro <financeiro@excursaodascomitivas.com.br>
EMAIL_REPLY_TO=atendimento@excursaodascomitivas.com.br

# Pagamentos: Banco Cora
PAYMENT_GATEWAY=cora
CORA_ENV=stage
CORA_CLIENT_ID=
CORA_CERT_PATH=/run/secrets/cora-stage-certificate.pem
CORA_PRIVATE_KEY_PATH=/run/secrets/cora-stage-private-key.key
CORA_TOKEN_URL=https://matls-clients.api.stage.cora.com.br/token
CORA_API_BASE_URL=https://matls-clients.api.stage.cora.com.br
CORA_INSTALLMENTS_API_BASE_URL=https://api.stage.cora.com.br
CORA_WEBHOOK_PUBLIC_URL=https://excursaodascomitivas.com.br/api/pagamentos/webhook/cora
CORA_WEBHOOK_HMAC_SECRET=
CORA_HTTP_TIMEOUT_MS=15000
CORA_CARNE_TIMEOUT_MS=45000

# WhatsApp Business — opcional até ativação
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_OTP_TEMPLATE_NAME=validacao_contrato
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Armazenamento
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Follow-up automático
FOLLOWUP_CHECK_INTERVAL_MINUTOS=5

# Identidade pública
VITE_WHATSAPP_NUMERO=5561994459086
