# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/comitiva
ENABLE_TEST_ADMIN=false

# JWT e proteção de OTP — gerar valores fortes fora do repositório
JWT_SECRET=GERE_UMA_CHAVE_COM_OPENSSL_RAND_BASE64_32
OTP_PEPPER=GERE_OUTRA_CHAVE_FORTE_COM_OPENSSL_RAND_BASE64_32
AVISO_PRIVACIDADE_VERSION=2026.1

# Servidor
# Informe somente IPs/redes dos proxies sob seu controle; não use true ou *.
TRUSTED_PROXY_IPS=127.0.0.1,::1
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Pagamentos: Banco Cora é o único gateway de produção.
# Mock só pode ser usado em testes locais, nunca em produção.
PAYMENT_GATEWAY=cora
CORA_ENV=stage
CORA_CLIENT_ID=
CORA_CERT_PATH=/run/secrets/cora-stage-certificate.pem
CORA_PRIVATE_KEY_PATH=/run/secrets/cora-stage-private-key.key
CORA_TOKEN_URL=https://matls-clients.api.stage.cora.com.br/token
CORA_API_BASE_URL=https://matls-clients.api.stage.cora.com.br
CORA_INSTALLMENTS_API_BASE_URL=https://api.stage.cora.com.br
CORA_WEBHOOK_PUBLIC_URL=https://excursaodascomitivas.com.br/api/pagamentos/webhook/cora
CORA_WEBHOOK_HMAC_SECRET=GERE_UMA_CHAVE_FORTE_EXCLUSIVA_PARA_ASSINATURA_DO_WEBHOOK
CORA_HTTP_TIMEOUT_MS=15000
CORA_CARNE_TIMEOUT_MS=45000

# SMTP para e-mails transacionais
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Excursão das Comitivas <excursaodascomitivas@gmail.com>

# WhatsApp Business Platform/BSP autorizado — opcional até contratação
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_OTP_TEMPLATE_NAME=validacao_contrato
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Armazenamento
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Follow-up automático
FOLLOWUP_CHECK_INTERVAL_MINUTOS=5

# Identidade pública
MOBILE_URL=comitiva://
VITE_WHATSAPP_NUMERO=5561994459086
