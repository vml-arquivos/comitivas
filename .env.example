# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/comitiva
ENABLE_TEST_ADMIN=false

# JWT e proteção de OTP — gerar valores fortes fora do repositório
JWT_SECRET=GERE_UMA_CHAVE_COM_OPENSSL_RAND_HEX_32
OTP_PEPPER=GERE_OUTRA_CHAVE_FORTE_COM_OPENSSL_RAND_HEX_32
SYSTEM_SECRETS_MASTER_KEY=GERE_OUTRA_CHAVE_FORTE_COM_OPENSSL_RAND_HEX_32
AVISO_PRIVACIDADE_VERSION=2026.1

# Servidor
TRUSTED_PROXY_IPS=127.0.0.1,::1
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
MOBILE_URL=comitiva://

# Login social opcional. Os botões só aparecem quando ID e segredo do provedor
# estão configurados. Cadastre as URLs de retorno exatamente como abaixo.
OAUTH_PUBLIC_BASE_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/microsoft/callback

# Entrega de e-mail transacional
# Em DigitalOcean, prefira a API HTTPS da Brevo porque as portas SMTP 25/465/587
# podem ser bloqueadas no provedor. Quando BREVO_API_KEY estiver preenchida,
# o sistema usa a API HTTPS (porta 443) como transporte principal.
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_TIMEOUT_MS=15000
EMAIL_SMTP_FALLBACK=true

# SMTP / Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Excursão das Comitivas <sistema@excursaodascomitivas.com.br>
EMAIL_FROM_SYSTEM=Excursão das Comitivas <sistema@excursaodascomitivas.com.br>
EMAIL_FROM_SUPPORT=Excursão das Comitivas | Atendimento <atendimento@excursaodascomitivas.com.br>
EMAIL_FROM_CONTRACTS=Excursão das Comitivas | Contratos <contratos@excursaodascomitivas.com.br>
EMAIL_FROM_FINANCE=Excursão das Comitivas | Financeiro <financeiro@excursaodascomitivas.com.br>
EMAIL_REPLY_TO=atendimento@excursaodascomitivas.com.br
EMAIL_SUPPORT_INBOX=excursaodascomitivas@gmail.com

# Pagamentos: Banco Cora
PAYMENT_GATEWAY=cora
CORA_ENV=stage
CORA_CLIENT_ID=
CORA_CERT_PATH=/run/secrets/cora-stage-certificate.pem
CORA_PRIVATE_KEY_PATH=/run/secrets/cora-stage-private-key.key
CORA_TOKEN_URL=https://matls-clients.api.stage.cora.com.br/token
CORA_API_BASE_URL=https://matls-clients.api.stage.cora.com.br
CORA_INSTALLMENTS_API_BASE_URL=https://api.stage.cora.com.br
CORA_WEBHOOK_PUBLIC_URL=https://excursaodascomitivas.com.br/api/pagamentos/webhook/cora
CORA_WEBHOOK_HMAC_SECRET=
CORA_HTTP_TIMEOUT_MS=15000
CORA_CARNE_TIMEOUT_MS=45000

# WhatsApp Business — opcional até ativação
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_OTP_TEMPLATE_NAME=validacao_contrato
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Armazenamento
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Leitura de documento de identificação por imagem/PDF. A validação compara
# os dados extraídos com o cadastro; ela não aprova o cadastro automaticamente.
DOCUMENT_AI_PROVIDER=gemini
DOCUMENT_IDENTITY_REQUIRED_FOR_CONTRACT=true
GEMINI_API_KEY=
GEMINI_DOCUMENT_MODEL=gemini-2.5-flash
DOCUMENT_AI_TIMEOUT_MS=30000
DOCUMENT_AI_MIN_CONFIDENCE=0.85

# Follow-up automático
FOLLOWUP_CHECK_INTERVAL_MINUTOS=5

# Identidade pública
VITE_WHATSAPP_NUMERO=5561994459086
