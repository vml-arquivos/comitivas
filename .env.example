# Banco de Dados PostgreSQL
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/comitiva
ENABLE_TEST_ADMIN=false

# JWT
JWT_SECRET=GERE_UMA_CHAVE_COM_OPENSSL_RAND_BASE64_32

# Servidor
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Gateway de Pagamento (Mercado Pago - SANDBOX para testes)
PAYMENT_GATEWAY=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# SMTP para envio de e-mails (Mailtrap para testes)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=465
SMTP_USER=seu_mailtrap_user@mailtrap.io
SMTP_PASS=sua_mailtrap_password
SMTP_FROM=noreply@comitiva-test.com

# Armazenamento (local para desenvolvimento)
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# URLs públicas
WEB_URL=http://localhost:5173
MOBILE_URL=comitiva://

# Follow-up automático (job agendado)
FOLLOWUP_CHECK_INTERVAL_MINUTOS=5

# Logging
LOG_LEVEL=info


# WhatsApp CTA (botão flutuante no site público)
# Formato internacional sem espaços/símbolos, ex: 5561999999999
# Formato: DDI + DDD + número, sem espaços, sem +, sem traço (ex.: 5561994459086)
VITE_WHATSAPP_NUMERO=5561994459086
