{
  "name": "comitiva",
  "version": "1.0.0",
  "description": "Plataforma de venda de pacotes de excursão",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "cd apps/web && npm run dev",
    "build": "npm run build:server && npm run build:web",
    "build:server": "esbuild server/index.ts --bundle --platform=node --outfile=dist/index.js",
    "build:web": "cd apps/web && npm run build",
    "start": "node dist/index.js",
    "test": "vitest"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@trpc/server": "^10.45.0",
    "@trpc/client": "^10.45.0",
    "drizzle-orm": "^0.29.0",
    "pg": "^8.11.0",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^21.0.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "axios": "^1.6.0",
    "decimal.js": "^10.4.3",
    "@paralleldrive/cuid2": "^2.2.2"
  },
  "devDependencies": {
    "typescript": "^5.2.0",
    "tsx": "^4.0.0",
    "esbuild": "^0.19.0",
    "concurrently": "^8.2.0",
    "vitest": "^0.34.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^6.4.14"
  }
}
