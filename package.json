{
  "name": "comitiva",
  "version": "1.0.0",
  "description": "Plataforma de venda de pacotes de excursão",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "cd apps/web && npm run dev",
    "build": "npm run build:server && npm run build:web",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "build:web": "cd apps/web && npm run build",
    "start": "node dist/index.js",
    "db:migrate": "tsx scripts/aplicar-migrations.ts",
    "seed:barretos-2026": "tsx scripts/seed-barretos-2026.ts",
    "db:verify-contract-fields": "node scripts/verificar-migration.mjs",
    "test": "vitest",
    "test:e2e": "tsx scripts/e2e-fluxo-completo.mts"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.3.1",
    "drizzle-orm": "0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "4.6.0",
    "nodemailer": "9.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.0",
    "puppeteer-core": "25.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.8",
    "@types/nodemailer": "^6.4.14",
    "concurrently": "^8.2.0",
    "esbuild": "0.28.1",
    "tsx": "^4.0.0",
    "typescript": "^5.2.0",
    "vitest": "4.1.10"
  }
}
