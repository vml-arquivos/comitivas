# ========================================
# CONFIGURAÇÃO DE TESTE - COMITIVA PRIME
# ========================================
# Este arquivo contém as variáveis MÍNIMAS para testar o sistema
# SEM o gateway de pagamento. Use para validar o fluxo antes de produção.
#
# Data: 23 de julho de 2026
# Status: Temporário - Revogue e altere após testes

# ========================================
# SUBDOMÍNIOS NECESSÁRIOS (2 apenas)
# ========================================
# 1. comitivaprime-test.com.br (site + sistema)
# 2. api-test.comitivaprime-test.com.br (API backend)
#
# Configure no seu DNS:
# comitivaprime-test.com.br          A  seu_ip_servidor
# api-test.comitivaprime-test.com.br A  seu_ip_servidor
#
# Ou use localhost para teste local:
# API_URL=http://localhost:3000
# WEB_URL=http://localhost:5173

# ========================================
# 1. BANCO DE DADOS (PostgreSQL)
# ========================================
# Para teste, use um banco temporário:
# - Supabase (gratuito): https://supabase.com
# - Railway (gratuito): https://railway.app
# - Docker local: postgresql://user:pass@localhost:5432/comitiva_teste

DATABASE_URL=postgresql://USUARIO_TESTE:SENHA_TESTE@localhost:5432/comitiva_teste

# ========================================
# 2. SEGURANÇA - JWT
# ========================================
# Gere com: openssl rand -base64 32
# Este é apenas um exemplo - GERE UM NOVO para teste

JWT_SECRET=GERE_UMA_CHAVE_DE_TESTE_COM_OPENSSL_RAND_BASE64_32

# ========================================
# 3. SERVIDOR
# ========================================
NODE_ENV=development
PORT=3000

# URLs dos subdomínios de teste
# Para localhost: use http://localhost:3000 e http://localhost:5173
# Para domínio de teste: use https://api-test.comitivaprime-test.com.br
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
MOBILE_URL=comitiva://

# ========================================
# 4. SMTP (E-mail de Teste)
# ========================================
# Use Mailtrap (gratuito, 500 e-mails/mês)
# Cadastre em: https://mailtrap.io
# Copie as credenciais da aba "SMTP Settings"

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=seu_usuario_mailtrap@mailtrap.io
SMTP_PASS=sua_senha_mailtrap_aqui
SMTP_FROM=noreply@comitivaprime-test.com.br

# ========================================
# 5. ARMAZENAMENTO (Local para Teste)
# ========================================
# Teste com armazenamento local
# Em produção, mude para S3

STORAGE_TYPE=local
STORAGE_PATH=./uploads

# ========================================
# 6. FOLLOW-UP AUTOMÁTICO
# ========================================
# Intervalo em minutos para verificar leads abandonados
FOLLOWUP_CHECK_INTERVAL_MINUTOS=5

# ========================================
# 7. LOGGING
# ========================================
LOG_LEVEL=debug

# ========================================
# 8. GATEWAY DE PAGAMENTO (DESABILITADO)
# ========================================
# Para teste SEM pagamento real, deixe vazio ou use "mock"
# Quando quiser testar pagamento, mude para "mercadopago" e preencha credenciais

PAYMENT_GATEWAY=mock
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# ========================================
# INSTRUÇÕES DE USO
# ========================================
# 1. Copie este arquivo para .env na raiz do projeto
# 2. Altere as variáveis conforme seu ambiente:
#    - DATABASE_URL: seu PostgreSQL
#    - SMTP_*: suas credenciais Mailtrap
#    - JWT_SECRET: gere um novo com openssl rand -base64 32
# 3. Inicie o servidor: npm run dev
# 4. Acesse: http://localhost:5173
# 5. Teste o fluxo completo (cadastro, login, pacote, checkout)
# 6. IMPORTANTE: Não faça commit deste arquivo com dados reais
# 7. Após testes, revogue as credenciais e altere as senhas
